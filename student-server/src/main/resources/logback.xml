<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="10 seconds">
    <!-- 引用Spring Boot 默认日志配置 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 1. 基础配置：定义日志路径和应用名称 -->
    <property name="LOG_PATH" value="./logs/student-server" />
    <property name="APP_NAME" value="student-server" />

    <!-- 2. 日志格式 -->
    <!-- [保留您的配置] 控制台日志打印格式：简洁模式 (时间 级别 线程Logger 内容) -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{HH:mm:ss}){faint}%clr([%5level]) %clr(%thread){yellow} %clr(%-40.40logger{39}){cyan} : %msg%n"/>

    <!-- [新增] 文件日志打印格式：全量模式 (包含日期，方便回溯) -->
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

    <!-- 3. Appenders 定义 -->

    <!-- [保留您的配置] 控制台输出 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- [新增] INFO 文件输出：按天滚动 -->
    <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/info/${APP_NAME}-info-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>15</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- [新增] ERROR 文件输出：单独存储错误，方便报警和排查 -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error/${APP_NAME}-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 4. 环境隔离配置 -->

    <!-- 开发环境：只打印控制台，并且开启 Mapper 的 SQL 打印 -->
    <springProfile name="dev,default">
        <!-- 让 MyBatis Mapper 打印 SQL 方便调试 -->
        <logger name="com.bob.student.mapper" level="DEBUG" />
        <root level="INFO">
            <appender-ref ref="console"/>
        </root>
    </springProfile>

    <!-- 生产/测试环境：打印控制台 + 写入文件 -->
    <springProfile name="prod,test">
        <root level="INFO">
            <appender-ref ref="console"/>
            <appender-ref ref="FILE_INFO"/>
            <appender-ref ref="FILE_ERROR"/>
        </root>
    </springProfile>

</configuration>